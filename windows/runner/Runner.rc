#include "resource.h"
#include "winres.h"

IDI_APP_ICON ICON "resources\\app_icon.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Version
//
// Keep the strings below ASCII only: this file is compiled with the system
// code page (936), so non-ASCII characters would fail to build.
//

#if defined(FLUTTER_VERSION_MAJOR) && defined(FLUTTER_VERSION_MINOR) && defined(FLUTTER_VERSION_PATCH) && defined(FLUTTER_VERSION_BUILD)
#define VERSION_AS_NUMBER FLUTTER_VERSION_MAJOR,FLUTTER_VERSION_MINOR,FLUTTER_VERSION_PATCH,FLUTTER_VERSION_BUILD
#else
#define VERSION_AS_NUMBER 1,0,0,0
#endif

#if defined(FLUTTER_VERSION)
#define VERSION_AS_STRING FLUTTER_VERSION
#else
#define VERSION_AS_STRING "1.0.0"
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION VERSION_AS_NUMBER
 PRODUCTVERSION VERSION_AS_NUMBER
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904e4"
        BEGIN
            VALUE "CompanyName", "Han1meWinPlus"
            VALUE "FileDescription", "Han1meWinPlus"
            // package_info_plus reads ProductVersion and splits on '+', so
            // "1.1.10+21" becomes version 1.1.10 with build number 21.
            VALUE "FileVersion", VERSION_AS_STRING
            VALUE "InternalName", "han1me_win_plus"
            VALUE "LegalCopyright", "Han1meWinPlus"
            VALUE "OriginalFilename", "han1me_win_plus.exe"
            VALUE "ProductName", "Han1meWinPlus"
            VALUE "ProductVersion", VERSION_AS_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1252
    END
END
