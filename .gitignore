
.dart_tool/
build/
pubspec.lock

# flutter pub get 生成的插件清单，内容含本机包路径
.flutter-plugins-dependencies

# FVM Version Cache
.fvm/

.idea/
*.iml

# IDE 生成的模块缓存，内容含机器绝对路径，不应入库
android/workspace.json

.vscode/

# Trae IDE 的工作目录（放的是 AI 会话产出的临时计划稿，与代码无关）
.trae/

# 本机编辑工具生成的状态文件，不参与版本控制
.dsh-edit-review.json
.dsh-edit-review-archive.json

# Agent 工作目录（本体与运行态），不属于项目代码
clear/

# 截图与图像工具的临时产物
.dsh_shots/
.dsh-tool-vision/

# 本地代码审查用的 ocr CLI（55MB 的官方预编译二进制，不入库）
# 脚本在 tools/ocr/ 下入库，换机器后跑 tools/ocr/setup.ps1 重新拉取
tools/ocr/bin/
# setup.ps1 的下载临时目录（正常会自清理，这里是兜底）
tools/ocr/.dl/

# 本地审查产出的材料文件
.review.md

# 截图 / 连拍工具的临时产物（.dsh_shots 里的脚本没传 -Out 时会落在仓库根）
/*.bmp
/*.png

# 设计稿比对用的临时脚本与截图（.design_tmp 下的 ov.py / shoot.ps1 等）；
# 每次按设计稿改界面都会重新生成，属于本地工作产物，不入库
.design_tmp/

# 仓库根目录下的一次性分析脚本（_m.py / _glyph.py / _shot.ps1 …）：
# 开头是下划线 + 短名，用于临时解析 APK、量字体墨迹、抓窗口截图等，
# 与本项目源码无关。真正的工具脚本放在 tools/ 下，不受这条影响。
/_*.py
/_*.ps1
/_*.json
/_*.png
/_*.bmp

# 图标抓取/裁切的中间产物（221 个 PNG，来自站点跑一遍后按 class 截取），
# 不是运行时资源 —— pubspec.yaml 没有引用这里，应用打包也不会带上
_icons/

# Widget Preview related
.widget_preview/

# Python 缓存（tools/ 下的脚本运行后产生）
__pycache__/
*.pyc
